# SauMGM API for one of several instances on this server: `saumgm@NAME` runs /opt/saumgm-NAME.
# Install: sudo cp deploy/systemd/saumgm@.service /etc/systemd/system/ && sudo systemctl daemon-reload
#          sudo systemctl enable --now saumgm@NAME
# Needs /etc/saumgm/NAME.env with the instance's port, e.g.:  PORT=8001  (optional: WORKERS=2)
# See docs/deploy/multiple-instances.md. The single-instance unit is saumgm.service.

[Unit]
Description=SauMGM API (instance %i)
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=saumgm-%i
Group=saumgm-%i
Environment=WORKERS=2
EnvironmentFile=/etc/saumgm/%i.env
WorkingDirectory=/opt/saumgm-%i/backend
ExecStart=/opt/saumgm-%i/backend/.venv/bin/uvicorn saumgm.main:app \
    --host 127.0.0.1 --port ${PORT} --workers ${WORKERS} \
    --proxy-headers --forwarded-allow-ips 127.0.0.1 \
    --no-server-header
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/saumgm-%i
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
