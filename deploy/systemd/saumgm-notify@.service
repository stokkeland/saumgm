# Emails the reminders digest of one instance (`saumgm-notify@NAME`); started daily by
# saumgm-notify@NAME.timer.
[Unit]
Description=SauMGM reminders digest (instance %i)
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=oneshot
User=saumgm-%i
Group=saumgm-%i
WorkingDirectory=/opt/saumgm-%i/backend
ExecStart=/opt/saumgm-%i/backend/.venv/bin/python -m saumgm notify
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
