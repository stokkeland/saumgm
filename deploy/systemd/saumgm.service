# SauMGM API (FastAPI under uvicorn), listening on localhost only; Apache proxies /api to it.
# Install: sudo cp deploy/systemd/saumgm.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now saumgm
# Configuration is read from /opt/saumgm/backend/.env (see docs/deploy/ubuntu.md, step 4).

[Unit]
Description=SauMGM API
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=saumgm
Group=saumgm
WorkingDirectory=/opt/saumgm/backend
# --proxy-headers: take the client's IP from Apache's X-Forwarded-For (for the audit log).
ExecStart=/opt/saumgm/backend/.venv/bin/uvicorn saumgm.main:app \
    --host 127.0.0.1 --port 8000 --workers 2 \
    --proxy-headers --forwarded-allow-ips 127.0.0.1 \
    --no-server-header
Restart=on-failure
RestartSec=5

# Hardening: read-only system, writable only where files are stored.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/saumgm
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
