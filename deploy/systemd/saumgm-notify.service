# Emails the reminders digest (python -m saumgm notify) if anything is due; started daily by
# saumgm-notify.timer. Add --if-idle DAYS to ExecStart to send only when nobody has signed in.
[Unit]
Description=SauMGM reminders digest
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=oneshot
User=saumgm
Group=saumgm
WorkingDirectory=/opt/saumgm/backend
ExecStart=/opt/saumgm/backend/.venv/bin/python -m saumgm notify
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
