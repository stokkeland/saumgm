# Daily reminders digest at 07:00 (server time; catches up after downtime).
# Install: sudo cp deploy/systemd/saumgm-notify.* /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now saumgm-notify.timer
[Unit]
Description=Daily SauMGM reminders digest

[Timer]
OnCalendar=*-*-* 07:00:00
Persistent=true

[Install]
WantedBy=timers.target
