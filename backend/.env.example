# Copy to .env and fill in. All settings can also be given as environment variables
# (prefix-free names, e.g. DATABASE_URL). .env is git-ignored.

# Application database (MariaDB 10.11+), PyMySQL driver.
DATABASE_URL=mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/saumgm?charset=utf8mb4

# Database used by automated tests; it is wiped and recreated by the test suite.
TEST_DATABASE_URL=mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/test_saumgm?charset=utf8mb4

# Where uploaded and generated files are stored (file:// now; s3:// / azure:// later).
STORAGE_URL=file:///var/lib/saumgm/storage

# development | production
ENVIRONMENT=development

# Comma-separated origins allowed to call the API from a browser (dev frontend server).
CORS_ORIGINS=http://localhost:5173

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
